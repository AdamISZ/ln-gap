From bb43f1b6a10e3145a5c2ac85da8238c626095016 Mon Sep 17 00:00:00 2001
From: waxwing <ekaggata@gmail.com>
Date: Sat, 10 Oct 2026 17:50:34 -0300
Subject: [PATCH 5/5] test: fault injection of a wrong long-jump hash
 (fail_jump)

A jump list's step committing to zeros for its long jump's hash at the
given step, so that a prover's dishonest jump hash can be tested.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 emulator/src/executor/fetcher.rs | 9 +++++----
 emulator/src/executor/utils.rs   | 4 ++++
 emulator/src/main.rs             | 1 +
 3 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/emulator/src/executor/fetcher.rs b/emulator/src/executor/fetcher.rs
index 8a86bfb..1736c71 100644
--- a/emulator/src/executor/fetcher.rs
+++ b/emulator/src/executor/fetcher.rs
@@ -141,10 +141,11 @@ pub fn execute_program(
                 .trace_step
                 .to_bytes();
 
-            program.hash = next_step_hash(program, &mut hasher, &trace_bytes);
+            let wrong_jump = fail_config.fail_jump == Some(program.step);
+            program.hash = next_step_hash(program, &mut hasher, &trace_bytes, wrong_jump);
             if let Some(fail) = fail_config.fail_hash {
                 if fail == program.step {
-                    program.hash = next_step_hash(program, &mut hasher, &trace_bytes);
+                    program.hash = next_step_hash(program, &mut hasher, &trace_bytes, false);
                 }
             }
         }
@@ -1138,11 +1139,11 @@ pub fn op_upper(
 
 /// The hash after the step just executed: linear, or a jump list's (which
 /// then records it if it is a long jump's target).
-fn next_step_hash(program: &mut Program, hasher: &mut blake3::Hasher, trace_bytes: &[u8]) -> [u8; 20] {
+fn next_step_hash(program: &mut Program, hasher: &mut blake3::Hasher, trace_bytes: &[u8], wrong_jump: bool) -> [u8; 20] {
     match program.jump.as_mut() {
         None => compute_step_hash(hasher, &program.hash, trace_bytes),
         Some(jt) => {
-            let j = jt.jump_hash(program.step, &program.hash);
+            let j = if wrong_jump { [0; 20] } else { jt.jump_hash(program.step, &program.hash) };
             let h = bitvmx_cpu_definitions::trace::compute_step_hash_jump(hasher, &program.hash, &j, trace_bytes, program.step);
             jt.record(program.step, &h);
             h
diff --git a/emulator/src/executor/utils.rs b/emulator/src/executor/utils.rs
index 3c3a549..614b486 100644
--- a/emulator/src/executor/utils.rs
+++ b/emulator/src/executor/utils.rs
@@ -245,6 +245,10 @@ pub struct FailConfiguration {
     pub fail_commitment_hash: bool,
     pub fail_selection_bits: Option<FailSelectionBits>,
     pub fail_prover_challenge_step: bool,
+    /// A jump list's step committing to a wrong long-jump hash (zeros) at
+    /// this step.
+    #[serde(default)]
+    pub fail_jump: Option<u64>,
 }
 
 impl FailConfiguration {
diff --git a/emulator/src/main.rs b/emulator/src/main.rs
index be70888..afeb2f8 100644
--- a/emulator/src/main.rs
+++ b/emulator/src/main.rs
@@ -558,6 +558,7 @@ fn main() -> Result<(), EmulatorError> {
                 fail_commitment_hash: *fail_commitment_hash,
                 fail_selection_bits: None,
                 fail_prover_challenge_step: false,
+                fail_jump: None,
             };
             let result = execute_program(
                 &mut program,

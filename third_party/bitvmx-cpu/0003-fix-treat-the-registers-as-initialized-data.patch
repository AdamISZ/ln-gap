From 99a867bc814b3ef593c2219659df7992ab854fbe Mon Sep 17 00:00:00 2001
From: Adam Gibson <adamisz@protonmail.com>
Date: Wed, 30 Sep 2026 14:55:44 -0300
Subject: [PATCH 3/5] fix: treat the registers as initialized data

The loader initializes the registers (sp is not zero), but
get_uninitialized_ranges listed the register section as uninitialized,
so the UninitializedData challenge (the value must be zero) succeeded
against an honest first read of sp. Excluding the section from the
uninitialized ranges alone would leave a never-written register read
unchallengeable, so the registers become initialized data instead:
get_initialized_chunks adds chunks holding the loader's register values,
and verifier_choose_challenge routes a never-written register read to
InitializedData. test_initialized_challenge_register_read checks that
the honest sp is not challengeable and a wrong one is.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 emulator/src/decision/challenge.rs | 33 +++++++++++++++++++++++++++++-
 emulator/src/loader/program.rs     | 29 ++++++++++++++++++++++----
 2 files changed, 57 insertions(+), 5 deletions(-)

diff --git a/emulator/src/decision/challenge.rs b/emulator/src/decision/challenge.rs
index f27296a..168df5c 100644
--- a/emulator/src/decision/challenge.rs
+++ b/emulator/src/decision/challenge.rs
@@ -724,7 +724,7 @@ pub fn verifier_choose_challenge(
                     address: conflict_address,
                     input_for_address: value,
                 });
-            } else if (section.initialized && force == ForceChallenge::No)
+            } else if ((section.initialized || section.registers) && force == ForceChallenge::No)
                 || force == ForceChallenge::InitializedData
             {
                 info!("Verifier choose to challenge invalid INITIALIZED DATA");
@@ -2881,4 +2881,35 @@ mod tests {
         };
         assert!(!execute_challenge(&challenge));
     }
+
+    // With the registers as initialized data, a never-written register read
+    // is checked against the loader's value: the honest sp at hello-world's
+    // step 3 is not challengeable, a wrong one is.
+    #[test]
+    fn test_initialized_challenge_register_read() {
+        init_trace();
+        let pdf = "../docker-riscv32/riscv32/build/hello-world.yaml";
+        let path = "../temp-runs/challenge/initialized-register/";
+        let input = vec![17, 17, 17, 17];
+        prover_execute(pdf, input.clone(), path, path, true, None, false).unwrap();
+        let program_def = ProgramDefinition::from_config(pdf).unwrap();
+        let (_, trace) = program_def
+            .execute_helper(path, path, input, Some(vec![2, 3]), None, false)
+            .unwrap();
+        let step_3 = &trace[1].0;
+        let program = program_def.load_program().unwrap();
+        let chunks = program.get_initialized_chunks(bitvmx_cpu_definitions::constants::CHUNK_SIZE);
+        let chunk_index = super::find_chunk_index(&chunks, step_3.read_1.address).unwrap();
+        let challenge = |read_1: TraceRead| ChallengeType::InitializedData {
+            prover_read_1: read_1,
+            prover_read_2: step_3.read_2.clone(),
+            read_selector: 1,
+            chunk_index: chunk_index as u32,
+            chunk: Some(chunks[chunk_index].clone()),
+        };
+        assert!(!execute_challenge(&challenge(step_3.read_1.clone())));
+        let mut lie = step_3.read_1.clone();
+        lie.value ^= 1;
+        assert!(execute_challenge(&challenge(lie)));
+    }
 }
diff --git a/emulator/src/loader/program.rs b/emulator/src/loader/program.rs
index cb8528f..5cf45ca 100644
--- a/emulator/src/loader/program.rs
+++ b/emulator/src/loader/program.rs
@@ -642,9 +642,27 @@ impl Program {
     }
 
     pub fn get_initialized_chunks(&self, chunk_size: u32) -> Vec<Chunk> {
-        self.get_chunks(chunk_size, |section| {
+        let mut chunks = self.get_chunks(chunk_size, |section| {
             section.initialized && !section.is_code
-        })
+        });
+        // The registers are initialized by the loader (sp is not zero), but
+        // their section's data is not where their values live: take them
+        // from the registers themselves.
+        if let Some(section) = self.sections.iter().find(|section| section.registers) {
+            let values: Vec<u32> = (0..section.size / 4)
+                .map(|idx| self.registers.get(idx))
+                .collect();
+            chunks.extend(
+                values
+                    .chunks(chunk_size as usize)
+                    .enumerate()
+                    .map(|(index, data)| Chunk {
+                        base_addr: section.start + index as u32 * chunk_size * 4,
+                        data: data.to_vec(),
+                    }),
+            );
+        }
+        chunks
     }
 
     pub fn get_code_chunks(&self, chunk_size: u32) -> Vec<Chunk> {
@@ -659,8 +677,11 @@ impl Program {
             .sections
             .iter()
             .filter(|section| {
-                // we do inputs separately
-                !section.initialized && section.name != program_definition.input_section_name
+                // we do inputs separately; the registers are initialized by
+                // the loader (see get_initialized_chunks)
+                !section.initialized
+                    && !section.registers
+                    && section.name != program_definition.input_section_name
             })
             .map(|section| section.range())
             .collect();

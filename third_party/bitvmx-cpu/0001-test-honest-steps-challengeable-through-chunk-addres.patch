From daaedd8dcea211912cb14f1af5a445d5bca92cdc Mon Sep 17 00:00:00 2001
From: Adam Gibson <adamisz@protonmail.com>
Date: Wed, 30 Sep 2026 14:55:33 -0300
Subject: [PATCH 1/5] test: honest steps challengeable through chunk addressing
 and register initialization

Three tests that fail on dev (299009c6):

- test_code_chunks_hold_the_words_at_their_addresses: get_chunks places
  chunk i at section.start + i * chunk_size although a chunk holds
  chunk_size words, so every chunk after a section's first claims the
  wrong addresses (Groth16 verifier: the chunk claiming 0x80000064 holds
  the word from 0x80000190).
- test_opcode_challenge_honest_step_beyond_first_chunk: consequently the
  Opcode challenge succeeds against the honest instruction at 0x8000064c.
- test_uninitialized_challenge_honest_register_read: the register section
  is listed as uninitialized, but the loader sets sp; hello-world's
  honest step 3 reads sp (never written, value 0xe0800000) and the
  UninitializedData challenge succeeds against it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 emulator/src/decision/challenge.rs | 89 ++++++++++++++++++++++++++++++
 1 file changed, 89 insertions(+)

diff --git a/emulator/src/decision/challenge.rs b/emulator/src/decision/challenge.rs
index 7572a9f..f27296a 100644
--- a/emulator/src/decision/challenge.rs
+++ b/emulator/src/decision/challenge.rs
@@ -2792,4 +2792,93 @@ mod tests {
             ForceChallenge::No,
         );
     }
+
+    // Every code chunk must hold, at each address it covers, the word the
+    // program has there. get_chunks places chunk i at
+    // section.start + i * chunk_size, but a chunk holds chunk_size words
+    // (4 bytes each), so every chunk after the first of a section claims the
+    // wrong addresses. Any program larger than one chunk is affected; the
+    // Groth16 verifier has about 950 code chunks.
+    #[test]
+    fn test_code_chunks_hold_the_words_at_their_addresses() {
+        let program = crate::loader::program::load_elf(
+            "../docker-riscv32/verifier/build/zkverifier-new-mul.elf",
+            false,
+        )
+        .unwrap();
+        for chunk in program.get_code_chunks(bitvmx_cpu_definitions::constants::CHUNK_SIZE) {
+            for (i, word) in chunk.data.iter().enumerate() {
+                let address = chunk.base_addr + 4 * i as u32;
+                let section = program
+                    .sections
+                    .iter()
+                    .find(|s| s.is_code && s.start <= address && address < s.start + s.size)
+                    .expect("a chunk address lies in a code section");
+                let expected = u32::from_be(section.data[((address - section.start) / 4) as usize]);
+                assert_eq!(*word, expected, "word at {:#x}", address);
+            }
+        }
+    }
+
+    // The Opcode challenge must fail against the instruction the program
+    // really has at the pc. With the chunk addressing above, the chunk
+    // found for 0x8000064c in the Groth16 verifier holds a different word
+    // there, so the challenge succeeds against an honest step.
+    #[test]
+    fn test_opcode_challenge_honest_step_beyond_first_chunk() {
+        let program = crate::loader::program::load_elf(
+            "../docker-riscv32/verifier/build/zkverifier-new-mul.elf",
+            false,
+        )
+        .unwrap();
+        let pc = 0x8000_064c;
+        let section = program
+            .sections
+            .iter()
+            .find(|s| s.is_code && s.start <= pc && pc < s.start + s.size)
+            .unwrap();
+        let opcode = u32::from_be(section.data[((pc - section.start) / 4) as usize]);
+        let chunks = program.get_code_chunks(bitvmx_cpu_definitions::constants::CHUNK_SIZE);
+        let chunk_index = super::find_chunk_index(&chunks, pc).unwrap();
+        let challenge = ChallengeType::Opcode {
+            prover_pc_read: TraceReadPC::new(ProgramCounter::new(pc, 0), opcode),
+            chunk_index: chunk_index as u32,
+            chunk: Some(chunks[chunk_index].clone()),
+        };
+        assert!(!execute_challenge(&challenge));
+    }
+
+    // An honest read must not be challengeable as uninitialized.
+    // hello-world reads sp (x2) at step 3: the loader set it (0xe0800000)
+    // and no step has written it, so its last_step is LAST_STEP_INIT.
+    // get_uninitialized_ranges lists the register section as uninitialized,
+    // so the UninitializedData challenge (the value must be zero) succeeds
+    // against this honest read.
+    #[test]
+    fn test_uninitialized_challenge_honest_register_read() {
+        init_trace();
+        let pdf = "../docker-riscv32/riscv32/build/hello-world.yaml";
+        let path = "../temp-runs/challenge/uninitialized-register/";
+        let input = vec![17, 17, 17, 17];
+        prover_execute(pdf, input.clone(), path, path, true, None, false).unwrap();
+        let program_def = ProgramDefinition::from_config(pdf).unwrap();
+        let (_, trace) = program_def
+            .execute_helper(path, path, input, Some(vec![2, 3]), None, false)
+            .unwrap();
+        let step_3 = &trace[1].0;
+        assert_eq!(
+            step_3.read_1.last_step,
+            bitvmx_cpu_definitions::constants::LAST_STEP_INIT
+        );
+        assert_ne!(step_3.read_1.value, 0);
+
+        let program = program_def.load_program().unwrap();
+        let challenge = ChallengeType::UninitializedData {
+            prover_read_1: step_3.read_1.clone(),
+            prover_read_2: step_3.read_2.clone(),
+            read_selector: 1,
+            sections: Some(program.get_uninitialized_ranges(&program_def)),
+        };
+        assert!(!execute_challenge(&challenge));
+    }
 }

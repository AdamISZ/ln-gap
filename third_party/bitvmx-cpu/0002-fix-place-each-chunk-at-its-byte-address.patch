From f571161e98e04d3e29530f11301c2d32d815f879 Mon Sep 17 00:00:00 2001
From: Adam Gibson <adamisz@protonmail.com>
Date: Wed, 30 Sep 2026 14:55:34 -0300
Subject: [PATCH 2/5] fix: place each chunk at its byte address

get_chunks computed a chunk's base as section.start + index * chunk_size,
counting words as bytes; a chunk holds chunk_size words, so chunk i
starts at section.start + index * chunk_size * 4. Affects the code
chunks (Opcode challenge) and the initialized-data chunks
(InitializedData challenge) of any program larger than one chunk.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 emulator/src/loader/program.rs | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/emulator/src/loader/program.rs b/emulator/src/loader/program.rs
index 8172b90..cb8528f 100644
--- a/emulator/src/loader/program.rs
+++ b/emulator/src/loader/program.rs
@@ -629,7 +629,8 @@ impl Program {
                     .chunks(chunk_size as usize)
                     .enumerate()
                     .map(|(index, chunk)| {
-                        let offset = section.start + index as u32 * chunk_size;
+                        // chunk_size is in words: each chunk spans chunk_size * 4 bytes
+                        let offset = section.start + index as u32 * chunk_size * 4;
                         let data = chunk.iter().map(|opcode| u32::from_be(*opcode)).collect();
                         Chunk {
                             base_addr: offset,
